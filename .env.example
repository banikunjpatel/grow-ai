# Anthropic API key for Claude model calls
# Required unless MOCK=true. The server refuses to start without it otherwise.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Enable mock mode (true/false) — off by default
# When set to "true", the /api/grow endpoint returns hardcoded responses without making API calls
# This allows the frontend's act-reflect-advance loop to be tested before wiring up the actual AI
MOCK=false

# Server port (optional, defaults to 3000)
PORT=3000

# Frontend origin allowed to call this API (CORS).
# Set to your deployed frontend's exact origin, no trailing slash.
# Defaults to "*" (all origins) if unset.
CORS_ORIGIN=
https://grow-ai-client.onrender.com/
